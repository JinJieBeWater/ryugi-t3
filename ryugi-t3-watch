#!/usr/bin/env python3
"""Wake the T3 thread that opened a Ryugi choice round."""
import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
import uuid

LAUNCHCTL = "/bin/launchctl"
POLL_SECONDS = 2


def run_json(argv):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise ValueError(f"{Path(argv[0]).name} exited {result.returncode}")
    return json.loads(result.stdout)


def executable(name):
    path = shutil.which(name)
    if not path:
        raise ValueError(f"Executable unavailable: {name}")
    return os.path.abspath(path)


@contextmanager
def binding(directory):
    """Keep the lock inode stable; replace only the JSON record."""
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        file = directory / "binding.json"
        data = json.loads(file.read_text()) if file.exists() else {}
        before = data.copy()
        yield data
        if data != before:
            tmp = directory / "next.json"
            with tmp.open("w") as out:
                json.dump(data, out, ensure_ascii=False)
                out.flush()
                os.fsync(out.fileno())
            tmp.replace(file)
            fd = os.open(directory, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)


def t3_args(record, op):
    return [record["t3"], "thread", op, "--base-dir", record["base"], "--json"]


def show(record, count=0):
    value = run_json(t3_args(record, "show") + ["--messages", str(count), record["thread"]])
    if value["thread"]["threadId"] != record["thread"]:
        raise ValueError("T3 returned a different thread")
    return value


def round_state(record):
    args = [record["ryugi"], "comment", "list", "--project-dir", record["project"],
            "--artifact", record["artifact"], "--section", "rounds", "--detail", "--json"]
    cursor = None
    cursors = set()
    while True:
        result = run_json(args + (["--cursor", cursor] if cursor else []))
        if result.get("outcome") != "success":
            raise ValueError("Ryugi has no current round snapshot")
        for item in result["data"]["items"]:
            if item["id"] == record["round"]:
                return item["state"]
        cursor = result["page"]["nextCursor"]
        if not cursor:
            return None
        if cursor in cursors:
            raise ValueError("Ryugi returned a repeated page cursor")
        cursors.add(cursor)


def launchctl(*args):
    return subprocess.run([LAUNCHCTL, *args], capture_output=True, text=True, timeout=10)


def submit_job(directory, record):
    result = launchctl("submit", "-l", record["job"], "--", sys.executable,
                       str(Path(__file__).resolve()), "_worker", str(directory), record["job"])
    if result.returncode:
        raise ValueError("launchctl submit: " + result.stderr.strip())


def notification(record):
    target = json.dumps({k: record[k] for k in ("project", "artifact", "round")},
                        ensure_ascii=False)
    return (f"[ryugi:{record['job']}] 画板轮次已提交。请用裸 ryugi 读取以下目标的最新选择；"
            f"仍为 submitted 时继续原任务，若已撤回则等待新决定。目标 {target}")


def tick(directory, job):
    with binding(directory) as record:
        if record.get("job") != job or record["state"] != "waiting":
            return False
        if time.time() >= record["deadline"]:
            record["state"] = "expired"
            return False
        config = record.copy()

    # Preflight the recipient before the final, fresh read of the selection.
    try:
        if round_state(config) != "submitted":
            return True
        recipient = show(config)["thread"]
        if recipient.get("archived"):
            with binding(directory) as record:
                if record["job"] == job and record["state"] == "waiting":
                    record["state"] = "cancelled"
            return False
        if round_state(config) != "submitted":
            return True
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        # Temporary errors before sending cannot result in a duplicate delivery.
        return True

    with binding(directory) as record:
        if record["job"] != job or record["state"] != "waiting":
            return False
        if time.time() >= record["deadline"]:
            record["state"] = "expired"
            return False
        record["state"] = "sending"

    try:
        receipt = run_json(t3_args(config, "send") + [config["thread"], notification(config)])
        accepted = (receipt.get("threadId") == config["thread"]
                    and receipt.get("delivery") in ("started", "queued")
                    and bool(receipt.get("messageId")))
    except (FileNotFoundError, PermissionError):
        # exec failed before T3 could accept a message.
        with binding(directory) as record:
            record["state"] = "waiting"
        return True
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        accepted = False
    with binding(directory) as record:
        record["state"] = "delivered" if accepted else "uncertain"
        if accepted:
            record["messageId"] = receipt["messageId"]
    return False


def worker(directory, job):
    try:
        with binding(directory) as record:
            if record.get("job") != job:
                return
            os.environ["PATH"] = record["path"]
            if record.get("serverHome"):
                os.environ["RYUGI_SERVER_HOME"] = record["serverHome"]
        while tick(directory, job):
            time.sleep(POLL_SECONDS)
    finally:
        launchctl("remove", job)


def public(record):
    keys = ("state", "thread", "project", "artifact", "round", "deadline", "messageId")
    return {k: record[k] for k in keys if k in record}


def command(args):
    project = args.project.resolve()
    store = project / ".ryugi/artifacts"
    if args.op == "arm" and not store.is_dir():
        raise ValueError("--project must be the Ryugi root containing .ryugi/artifacts")
    if not re.fullmatch(r"artboard/[a-z0-9][a-z0-9-]*", args.artifact):
        raise ValueError("Expected a project directory and artboard/<id>")
    if not args.round.strip() or any(ord(c) < 32 for c in args.round):
        raise ValueError("Expected a round ID")
    current = os.environ.get("T3CODE_THREAD_ID")
    if current and args.thread and current != args.thread:
        raise ValueError("--thread differs from the current T3 thread")
    thread = current or args.thread
    if not thread:
        raise ValueError("Supply the current T3 context's thread ID via --thread")
    base = str(args.base_dir.expanduser().resolve())
    identity = [str(store.resolve()), args.artifact, args.round]
    key = hashlib.sha256(json.dumps(identity).encode()).hexdigest()
    root = Path(os.getenv("XDG_STATE_HOME") or Path.home()/".local/state")
    directory = root / "ryugi-t3-watch" / key
    if args.op != "arm" and not (directory/"binding.json").is_file():
        raise ValueError("No binding for this round")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    with binding(directory) as record:
        if record and (record["thread"], record["base"]) != (thread, base):
            raise ValueError("Another T3 thread or instance owns this round")
        if args.op == "cancel":
            if record["state"] == "waiting":
                record["state"] = "cancelled"
                launchctl("remove", record["job"])
            return public(record)
        if args.op == "status":
            job_alive = launchctl("list", record["job"]).returncode == 0
            if record["state"] == "sending" and not job_alive:
                record["state"] = "uncertain"
            if record["state"] == "uncertain":
                try:
                    recent = show(record, count=25)["messages"]
                except (OSError, ValueError, KeyError, subprocess.SubprocessError):
                    recent = []
                for item in recent:
                    if item.get("role") == "user" and item.get("text") == notification(record):
                        record["state"] = "delivered"
                        break
            result = public(record)
            result["jobActive"] = job_alive
            return result

        if record:
            if record["state"] in ("sending", "uncertain"):
                raise ValueError("Delivery may already have been accepted; check status")
            if record["state"] == "waiting" and launchctl("list", record["job"]).returncode == 0:
                return public(record)
            if record["state"] == "delivered":
                if not args.again:
                    return public(record)
                if round_state(record) != "open":
                    raise ValueError("--again requires a reopened round")
        config = dict(project=str(project), artifact=args.artifact, round=args.round, thread=thread,
                      base=base, t3=executable(os.getenv("T3CODE_CLI_PATH") or "t3"),
                      ryugi=executable("ryugi"), path=os.environ["PATH"],
                      serverHome=os.getenv("RYUGI_SERVER_HOME"))
        if show(config)["thread"].get("archived"):
            raise ValueError("Thread is archived")
        config.update(job="local.ryugi-t3."+uuid.uuid4().hex, state="waiting",
                      deadline=time.time()+args.ttl)
        submit_job(directory, config)
        record.clear()
        record.update(config)
        return public(record)


def main():
    os.umask(0o077)
    if len(sys.argv) == 4 and sys.argv[1] == "_worker":
        worker(Path(sys.argv[2]), sys.argv[3])
        return
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Use the bare ryugi CLI for a fresh bridge artboard. Arm a new round before sharing it. "
        "Example: ryugi-t3-watch arm --artifact artboard/settings --round layout"))
    subs = parser.add_subparsers(dest="op", required=True)
    for op, help_text in [("arm","Bind the current thread and wait for a submission"),
                          ("status","Inspect this binding and reconcile an uncertain receipt"),
                          ("cancel","Stop waiting for this round")]:
        p = subs.add_parser(op, help=help_text)
        p.add_argument("--project", type=Path, default=Path.cwd(), help="Ryugi project root")
        p.add_argument("--artifact", required=True, metavar="artboard/ID")
        p.add_argument("--round", required=True, metavar="ID")
        p.add_argument("--thread", help="Current thread ID if not provided by T3")
        p.add_argument("--base-dir", type=Path, default=Path(os.getenv("T3CODE_HOME") or "~/.t3"))
        if op == "arm":
            p.add_argument("--ttl", type=int, default=86400, help="Seconds to wait (default 86400)")
            p.add_argument("--again", action="store_true", help="Rearm a delivered, reopened round")
    args = parser.parse_args()
    if args.op == "arm" and args.ttl <= 0:
        parser.error("--ttl must be positive")
    print(json.dumps(command(args), ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(f"ryugi-t3-watch: {error}")
